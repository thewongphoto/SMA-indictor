# Server-only values. Set Production values in Vercel; never use NEXT_PUBLIC_ for secrets.
APP_PASSWORD=
AUTH_SECRET=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# Generate these once on the private /setup page and keep a copy privately.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
# Optional HTTPS/contact mailto URI; the application has a default contact URL.
# VAPID_SUBJECT=
# Legacy worker mode only: leave BOTH unset to use local Python and IndexedDB.
# PYTHON_API_URL=https://your-private-worker.example
# PYTHON_API_TOKEN=
